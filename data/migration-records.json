  "simulatedSQL": "-- PORTFOLIO DEMO EXAMPLE - SANITISED RECONCILIATION METHOD (SYNTHETIC SCHEMA)\n-- Catches: (1) missing target row, (2) missing mapping rule, (3) NULL or mismatched target category, (4) doc_count/checksum drift\nSELECT\n    s.record_id,\n    s.category AS legacy_category,\n    t.category AS target_category,\n    m.target_code AS expected_category,\n    s.doc_count AS legacy_doc_count,\n    t.doc_count AS target_doc_count,\n    CASE\n        WHEN t.record_id IS NULL THEN 'ORPHANED_RECORD'\n        WHEN m.target_code IS NULL THEN 'MISSING_MAPPING_RULE'\n        WHEN t.category IS NULL OR t.category <> m.target_code THEN 'CATEGORY_MISMATCH_OR_NULL'\n        WHEN COALESCE(s.doc_count, -1) <> COALESCE(t.doc_count, -1) THEN 'BLOB_ATTACHMENT_MISMATCH'\n        WHEN COALESCE(s.checksum, '') <> COALESCE(t.checksum, '') THEN 'CHECKSUM_DRIFT'\n        ELSE 'PASS'\n    END AS reconciliation_verdict\nFROM demo_legacy_registry s\nLEFT JOIN demo_saas_target t ON s.record_id = t.record_id\nLEFT JOIN demo_category_mapping m ON s.category = m.legacy_code\nWHERE t.record_id IS NULL\n   OR m.target_code IS NULL\n   OR t.category IS NULL\n   OR t.category <> m.target_code\n   OR COALESCE(s.doc_count, -1) <> COALESCE(t.doc_count, -1)\n   OR COALESCE(s.checksum, '') <> COALESCE(t.checksum, '')\nORDER BY s.record_id ASC;"
